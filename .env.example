# Copia este archivo como .env para pruebas locales.
# En Railway, define estas mismas variables en Settings → Variables (no subas .env).

# Al agregar el plugin de Postgres en Railway, esta variable se crea sola
# y queda disponible automáticamente para tu servicio.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
ANA_PASSWORD=elige-una-contrasena-para-ana
CARLOS_PASSWORD=elige-una-contrasena-para-carlos
